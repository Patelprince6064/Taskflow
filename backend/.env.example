# TaskFlow backend environment variables
# Copy this file to `.env` (git-ignored) and adjust values if needed.

# Flask environment: development | testing | production
FLASK_ENV=development
# Enable the Werkzeug debugger and auto-reloader
FLASK_DEBUG=True
# Port the API listens on
PORT=5000
# Origin allowed by CORS (the Next.js dev server)
FRONTEND_URL=http://localhost:3000
