# TaskFlow - environment variable template (root reference)
#
# Copy the relevant section into the file each runtime actually loads:
#   frontend:  frontend/.env.local   (loaded by Next.js)
#   backend:   backend/.env          (loaded by python-dotenv)
# Service-level templates live next to each app (frontend/.env.example,
# backend/.env.example).
#
# NEVER commit real secrets, tokens or API keys.

# ---------- Frontend (Next.js) ----------
# Base URL of the Flask REST API
NEXT_PUBLIC_API_URL=http://localhost:5000

# ---------- Backend (Flask) ----------
# Flask environment: development | testing | production
FLASK_ENV=development
# Enable the Werkzeug debugger and auto-reloader
FLASK_DEBUG=True
# Port the API listens on
PORT=5000
# Origin allowed by CORS (the Next.js dev server)
FRONTEND_URL=http://localhost:3000
